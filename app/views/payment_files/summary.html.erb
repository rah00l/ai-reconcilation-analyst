          style: 'padding:9px 20px; background:#3b82f6; color:white; border-radius:6px; font-weight:600; font-size:13px; text-decoration:none; white-space:nowrap;' %>
      <%= link_to '← Back to Files', payment_files_path,
          style: 'padding:9px 20px; background:#6b7280; color:white; border-radius:6px; font-weight:600; font-size:13px; text-decoration:none; white-space:nowrap;' %>
