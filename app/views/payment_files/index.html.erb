<!-- JavaScript for responsive columns AND responsive summary grid -->
<script>
  // ── Beta modal ──────────────────────────────────────────
  function toggleBetaModal() {
    const modal = document.getElementById('beta-modal');
    if (modal.classList.contains('hidden')) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    } else {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = 'auto';
    }
  }

  function dismissBetaModal() {
    toggleBetaModal();
    try { localStorage.setItem('beta_modal_dismissed', '1'); } catch(e) {}
  }

  // Auto-show on first visit (unless dismissed)
  document.addEventListener('DOMContentLoaded', function() {
    try {
      if (!localStorage.getItem('beta_modal_dismissed')) {
        setTimeout(function() {
          const modal = document.getElementById('beta-modal');
          if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
          }
        }, 800);
      }
    } catch(e) {}
  });
</script>

<!-- JavaScript for responsive columns AND responsive summary grid -->
<script>
  // Handle responsive table columns
  function updateResponsiveColumns() {
    const width = window.innerWidth;
    let breakpoint = 'mobile';
    
    if (width >= 1024) breakpoint = 'lg';
    else if (width >= 768) breakpoint = 'md';
    else if (width >= 640) breakpoint = 'sm';
    
    document.querySelectorAll('[data-show]').forEach(el => {
      const show = el.getAttribute('data-show');
      let shouldShow = false;
      
      if (show === 'sm' && breakpoint !== 'mobile') shouldShow = true;
      if (show === 'md' && (breakpoint === 'md' || breakpoint === 'lg')) shouldShow = true;
      if (show === 'lg' && breakpoint === 'lg') shouldShow = true;
      
      el.style.display = shouldShow ? 'table-cell' : 'none';
    });
    
    document.querySelectorAll('[data-show-mobile]').forEach(el => {
      el.style.display = (breakpoint === 'mobile') ? 'inline' : 'none';
    });
  }
  
  // Handle responsive summary grid
  function updateSummaryGridLayout() {
    const width = window.innerWidth;
    const grid = document.getElementById('summaryGrid');
    
    if (!grid) return;
    
    if (width < 640) {
      // Mobile: 1 column
      grid.style.gridTemplateColumns = '1fr';
      grid.style.gap = '1rem';
    } else if (width < 1024) {
      // Tablet: 2 columns
      grid.style.gridTemplateColumns = 'repeat(2, 1fr)';
      grid.style.gap = '1.5rem';
    } else {
      // Desktop: 3 columns
      grid.style.gridTemplateColumns = 'repeat(3, 1fr)';
      grid.style.gap = '1.5rem';
    }
  }
  
  // Run functions on load and resize
  function initializeResponsive() {
    updateResponsiveColumns();
    updateSummaryGridLayout();
  }
  
  window.addEventListener('load', initializeResponsive);
  window.addEventListener('resize', initializeResponsive);
  initializeResponsive();
</script>
