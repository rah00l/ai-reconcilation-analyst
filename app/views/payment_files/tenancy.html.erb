<% @page_title = "Settlement" %>
<div style="min-height:100vh; background:#f3f4f6;">
  <div style="width:100%; padding:16px 16px 40px;">
    <%= render 'shared/header' %>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden" style="margin-bottom: 24px;">
      <div class="px-6 py-4 border-b border-gray-200">
        <h2 class="font-bold text-gray-900 text-base">Tenancy Transactions</h2>
      </div>
      <div class="overflow-x-auto">
        <div style="padding: 0 16px;">
        <table class="w-full text-sm" style="min-width:640px; border-collapse:collapse;">
          <thead>
            <tr class="bg-gray-50 border-b border-gray-200">
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide" style="white-space:nowrap;">Merchant <span class="text-red-400">*</span></th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide" style="white-space:nowrap;">Tenancy Tranx</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide" style="white-space:nowrap;">Mapped Campaign <span class="text-red-400">*</span></th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wide" style="white-space:nowrap;">Campaign Amt <span class="text-red-400">*</span></th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wide" style="white-space:nowrap;">Paid Amount <span class="text-red-400">*</span></th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wide" style="white-space:nowrap;">Tenancy Type <span class="text-red-400">*</span></th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
              <td class="px-4 py-4 font-medium text-gray-900" style="white-space:nowrap;">George at ASDA</td>
              <td class="px-4 py-4 text-gray-600" style="white-space:nowrap;">WL37017Q42025B</td>
              <td class="px-4 py-4">
                <select class="w-full px-2 py-1.5 border border-gray-300 rounded-md text-gray-900 text-sm bg-white focus:ring-2 focus:ring-blue-300 focus:border-blue-400 outline-none">
                  <option>George at ASDA-14608-WL37017Q42025B-1500.0</option>
                </select>
              </td>
              <td class="px-4 py-4 text-right font-semibold text-gray-900">1500.00</td>
              <td class="px-4 py-4 text-right">
                <input type="text" value="1500.00" class="w-24 px-2 py-1.5 border border-gray-300 rounded-md text-right text-sm focus:ring-2 focus:ring-blue-300 focus:border-blue-400 outline-none" />
              </td>
              <td class="px-4 py-4">
                <select class="w-full px-2 py-1.5 border border-gray-300 rounded-md text-gray-900 text-sm bg-white focus:ring-2 focus:ring-blue-300 focus:border-blue-400 outline-none">
                  <option>Tenancy</option>
                </select>
              </td>
            </tr>
            <tr class="border-b border-gray-100 hover:bg-gray-50 transition-colors">
              <td class="px-4 py-4 font-medium text-gray-900" style="white-space:nowrap;">Sainsburys Groceries Online</td>
              <td class="px-4 py-4 text-gray-500 text-xs leading-relaxed">Browser Adjustment<br>(advertiser: 1024283)</td>
              <td class="px-4 py-4">
                <select class="w-full px-2 py-1.5 border border-gray-300 rounded-md text-gray-900 text-sm bg-white focus:ring-2 focus:ring-blue-300 focus:border-blue-400 outline-none">
                  <option>Sainsburys Groceries Online-8966-WL29432Q42023-2500.0</option>
                </select>
              </td>
              <td class="px-4 py-4 text-right font-semibold text-gray-900">2500.00</td>
              <td class="px-4 py-4 text-right">
                <input type="text" value="1.03" class="w-24 px-2 py-1.5 border border-gray-300 rounded-md text-right text-sm focus:ring-2 focus:ring-blue-300 focus:border-blue-400 outline-none" />
              </td>
              <td class="px-4 py-4">
                <select class="w-full px-2 py-1.5 border border-gray-300 rounded-md text-gray-900 text-sm bg-white focus:ring-2 focus:ring-blue-300 focus:border-blue-400 outline-none">
                  <option>Tenancy</option>
                </select>
              </td>
            </tr>
            <tr class="hover:bg-gray-50 transition-colors">
              <td class="px-4 py-4 font-medium text-gray-900" style="white-space:nowrap;">Argos</td>
              <td class="px-4 py-4 text-gray-500 text-xs leading-relaxed">Browser Adjustment<br>(advertiser: 1024283)</td>
              <td class="px-4 py-4">
                <select class="w-full px-2 py-1.5 border border-gray-300 rounded-md text-gray-900 text-sm bg-white focus:ring-2 focus:ring-blue-300 focus:border-blue-400 outline-none">
                  <option>Argos-10840-WL34738Q22024-4500.0</option>
                </select>
              </td>
              <td class="px-4 py-4 text-right font-semibold text-gray-900">4500.00</td>
              <td class="px-4 py-4 text-right">
                <input type="text" value="84.46" class="w-24 px-2 py-1.5 border border-gray-300 rounded-md text-right text-sm focus:ring-2 focus:ring-blue-300 focus:border-blue-400 outline-none" />
              </td>
              <td class="px-4 py-4">
                <select class="w-full px-2 py-1.5 border border-gray-300 rounded-md text-gray-900 text-sm bg-white focus:ring-2 focus:ring-blue-300 focus:border-blue-400 outline-none">
                  <option>Tenancy</option>
                </select>
              </td>
            </tr>
          </tbody>
        </table>
        </div>
      </div>
      <div class="px-6 py-4 border-t border-gray-100 bg-gray-50">
        <button class="px-4 py-2 border border-gray-300 bg-white text-gray-600 rounded-md text-sm font-medium hover:bg-gray-100 transition-colors">
          ADD MORE ITEM
        </button>
      </div>
    </div>

    <!-- Fee Calculation — own white card, right-aligned -->
    <div style="margin-bottom: 24px; display:flex; justify-content:flex-end;">
      <div class="bg-white rounded-xl shadow-sm border border-gray-200 w-full md:w-2/5">
        <div class="px-6 py-4 border-b border-gray-100">
          <h2 class="font-bold text-gray-900 text-base">Fee Calculation</h2>
        </div>
        <div style="padding: 20px 24px;">
          <div style="display:flex; justify-content:space-between; align-items:center; padding: 10px 0; border-bottom: 1px solid #f3f4f6;">
            <span class="text-gray-600 text-sm">Tenancy Fee / BMG</span>
            <span class="text-sm text-gray-900">
              <span class="text-gray-400 mr-3">(1500.00)</span>
              <span class="font-semibold">1500.00</span>
            </span>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center; padding: 10px 0; border-bottom: 1px solid #f3f4f6;">
            <span class="text-gray-600 text-sm">Remaining Bonus</span>
            <span class="flex items-center gap-3">
              <span class="text-gray-400 text-sm">(-0.03)</span>
              <input type="text" value="-0.03" class="w-20 px-2 py-1.5 border border-gray-300 rounded-md text-right text-sm focus:ring-2 focus:ring-blue-300 focus:border-blue-400 outline-none" />
            </span>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center; padding: 10px 0; border-bottom: 1px solid #f3f4f6;">
            <span class="text-gray-600 text-sm">VAT</span>
            <input type="text" value="0.00" class="w-20 px-2 py-1.5 border border-gray-300 rounded-md text-right text-sm focus:ring-2 focus:ring-blue-300 focus:border-blue-400 outline-none" />
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center; padding: 10px 0; border-bottom: 1px solid #f3f4f6;">
            <span class="text-gray-600 text-sm">Unmatched Error</span>
            <span class="font-semibold text-gray-900 text-sm">106.07</span>
          </div>
          <div style="display:flex; justify-content:space-between; align-items:center; margin-top: 12px; background:#f9fafb; border-radius:8px; padding: 12px 16px;">
            <span class="font-bold text-gray-900">Total Amount:</span>
            <span class="font-bold text-gray-900">1606.04</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Action buttons — own white card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-6 py-5" style="margin-bottom: 24px;">
      <div class="flex flex-wrap gap-3 justify-between items-center">
        <div style="display:flex;flex-wrap:wrap;gap:10px;">
          <button style="display:inline-flex;align-items:center;padding:9px 20px;background:#3b82f6;color:white;border-radius:6px;font-weight:600;font-size:13px;border:none;cursor:pointer;white-space:nowrap;"
                  onmouseover="this.style.background='#2563eb'" onmouseout="this.style.background='#3b82f6'">TRAN RECONCILE</button>
          <button style="display:inline-flex;align-items:center;padding:9px 20px;background:#3b82f6;color:white;border-radius:6px;font-weight:600;font-size:13px;border:none;cursor:pointer;white-space:nowrap;"
                  onmouseover="this.style.background='#2563eb'" onmouseout="this.style.background='#3b82f6'">FULL RECONCILE</button>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px;">
          <button style="display:inline-flex;align-items:center;padding:9px 20px;background:#6b7280;color:white;border-radius:6px;font-weight:600;font-size:13px;border:none;cursor:pointer;white-space:nowrap;"
                  onmouseover="this.style.background='#4b5563'" onmouseout="this.style.background='#6b7280'">SAVE</button>
          <button style="display:inline-flex;align-items:center;padding:9px 20px;background:#6b7280;color:white;border-radius:6px;font-weight:600;font-size:13px;border:none;cursor:pointer;white-space:nowrap;"
                  onmouseover="this.style.background='#4b5563'" onmouseout="this.style.background='#6b7280'">DOWNLOAD</button>
        </div>
      </div>
    </div>

    <!-- Navigation — own white card -->
    <div class="bg-white rounded-xl shadow-sm border border-gray-200 px-6 py-5">
      <div style="display:flex;flex-wrap:wrap;gap:10px;">
        <%= link_to '← Back: Review', display_payment_file_path(@payment_file),
            style: 'display:inline-flex;align-items:center;padding:9px 20px;background:#3b82f6;color:white;border-radius:6px;font-weight:600;font-size:13px;text-decoration:none;white-space:nowrap;' %>
        <%= link_to 'Summary →', summary_payment_file_path(@payment_file),
            style: 'display:inline-flex;align-items:center;padding:9px 20px;background:#16a34a;color:white;border-radius:6px;font-weight:600;font-size:13px;text-decoration:none;white-space:nowrap;' %>
        <%= link_to '← Back to Files', payment_files_path,
            style: 'display:inline-flex;align-items:center;padding:9px 20px;background:#6b7280;color:white;border-radius:6px;font-weight:600;font-size:13px;text-decoration:none;white-space:nowrap;' %>
      </div>
    </div>

  </div>
</div>
