<!-- REUSABLE HEADER PARTIAL WITH SCREEN NAME -->
<!-- Responsive: stacks on mobile, horizontal on desktop -->
<div class="bg-white border-b border-gray-200 px-3 sm:px-4 md:px-6 py-3 sm:py-4 rounded-lg shadow-sm" style="margin-bottom: 24px;">

  <!-- MOBILE/TABLET LAYOUT (< 1024px): stacked -->
  <div class="lg:hidden">
    <!-- Row 1: Back + Screen Name -->
    <div class="flex items-center gap-3" style="margin-bottom: 10px;">
      <%= link_to '← Back', payment_files_path,
          style: 'color: #2563eb; font-weight: 600; font-size: 13px; white-space: nowrap; flex-shrink: 0; text-decoration: none;' %>
      <div class="w-px h-5 bg-gray-300 flex-shrink-0"></div>
      <div style="font-size: 18px; font-weight: 800; color: #111827; text-transform: uppercase; letter-spacing: 0.05em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
        <%= @page_title || action_name.titleize %>
      </div>
    </div>
    <!-- Row 2: Filename -->
    <p style="font-size: 11px; color: #6b7280; font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-bottom: 12px; padding: 0 2px;">
      <%= @payment_file.filename %>
    </p>
    <!-- Row 3: Info pills — 2x2 grid -->
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
      <div class="bg-gray-50 rounded px-3 py-2">
        <p class="text-xs text-gray-500 uppercase font-semibold tracking-wide">Region</p>
        <p style="font-size: 14px; font-weight: 700; color: #111827; text-transform: uppercase;"><%= @payment_file.region || 'N/A' %></p>
      </div>
      <div class="bg-gray-50 rounded px-3 py-2">
        <p class="text-xs text-gray-500 uppercase font-semibold tracking-wide">Network</p>
        <p class="text-sm font-bold text-gray-900"><%= @payment_file.affiliate_network %></p>
      </div>
      <div class="bg-gray-50 rounded px-3 py-2">
        <p class="text-xs text-gray-500 uppercase font-semibold tracking-wide mb-1">Status</p>
        <%= render 'shared/status_badge', status: @payment_file.status %>
      </div>
      <div class="bg-gray-50 rounded px-3 py-2">
        <p class="text-xs text-gray-500 uppercase font-semibold tracking-wide">Amount</p>
        <p class="text-sm font-bold text-purple-600"><%= number_to_currency(@transactions.sum(&:amount)) %></p>
      </div>
    </div>
  </div>

  <!-- DESKTOP LAYOUT (1024px+): single horizontal row -->
  <div class="hidden lg:flex items-center justify-between gap-8">

    <!-- Left: Back + Screen Name -->
    <div class="flex items-center flex-shrink-0" style="gap: 16px;">
      <%= link_to '← Back', payment_files_path,
          style: 'color: #2563eb; font-weight: 600; font-size: 14px; white-space: nowrap; text-decoration: none;' %>
      <div style="width: 1px; height: 24px; background: #d1d5db; flex-shrink: 0;"></div>
      <div style="font-size: 17px; font-weight: 800; color: #111827; text-transform: uppercase; letter-spacing: 0.05em; white-space: nowrap;">
        <%= @page_title || action_name.titleize %>
      </div>
    </div>

    <!-- Center: Filename -->
    <div class="flex-1 min-w-0 px-4">
      <h1 class="text-sm font-bold text-gray-900 truncate">
        <%= @payment_file.filename %>
      </h1>
    </div>

    <!-- Right: Info Items -->
    <div class="flex items-center flex-shrink-0" style="gap: 28px;">

      <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 2px;">
        <p style="font-size: 11px; color: #9ca3af; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Region</p>
        <p style="font-size: 13px; font-weight: 700; color: #111827; text-transform: uppercase;"><%= @payment_file.region || 'N/A' %></p>
      </div>

      <div style="width: 1px; height: 32px; background: #e5e7eb; flex-shrink: 0;"></div>

      <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 2px;">
        <p style="font-size: 11px; color: #9ca3af; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Network</p>
        <p style="font-size: 13px; font-weight: 700; color: #111827;"><%= @payment_file.affiliate_network %></p>
      </div>

      <div style="width: 1px; height: 32px; background: #e5e7eb; flex-shrink: 0;"></div>

      <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 4px;">
        <p style="font-size: 11px; color: #9ca3af; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Status</p>
        <%= render 'shared/status_badge', status: @payment_file.status %>
      </div>

      <div style="width: 1px; height: 32px; background: #e5e7eb; flex-shrink: 0;"></div>

      <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 2px;">
        <p style="font-size: 11px; color: #9ca3af; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em;">Amount</p>
        <p style="font-size: 14px; font-weight: 700; color: #9333ea;"><%= number_to_currency(@transactions.sum(&:amount)) %></p>
      </div>

    </div>

  </div>

</div>
