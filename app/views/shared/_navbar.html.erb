<!-- RESPONSIVE NAVBAR - With Mobile FAB Button for Questions -->
<!-- Works at: Mobile (320px), Tablet (640px), Desktop (1024px+) -->

<nav class="w-full border-b-4 border-blue-600 shadow-lg sticky top-0 z-40" style="background-color: #ffffff; color: #111827;">
  <div class="w-full px-3 sm:px-6 md:px-8 py-3 sm:py-4 md:py-5" style="background-color: #ffffff;">
    <div class="flex items-center justify-between h-auto gap-4 sm:gap-6 md:gap-8">
      
      <!-- LEFT: Logo & Branding - RESPONSIVE -->
      <div class="flex items-center gap-2 sm:gap-3 md:gap-5 flex-shrink-0">
        <!-- Logo -->
        <div class="w-12 h-12 sm:w-14 sm:h-14 md:w-16 md:h-16 flex-shrink-0 overflow-hidden">
          <img 
            src="/logo.svg" 
            alt="ReconPilot AI Logo" 
            class="w-full h-full object-contain drop-shadow-lg"
            title="ReconPilot AI - AI Payment Platform"
          >
        </div>
        
        <!-- Branding Text - RESPONSIVE -->
        <div class="flex flex-col gap-0">
          <span class="text-xl sm:text-2xl md:text-3xl font-bold leading-tight" style="color: #111827;">ReconPilot AI</span>
          <span class="text-xs sm:text-sm md:text-base font-semibold" style="color: #6b7280;">AI Payment Platform</span>
        </div>
      </div>

      <!-- CENTER: Questions Widget - HIDDEN ON MOBILE, VISIBLE ON TABLET+ -->
      <div class="hidden md:flex flex-1 justify-center px-4 lg:px-12">
        <%= render 'shared/questions_widget' %>
      </div>

      <!-- RIGHT: Icons - RESPONSIVE -->
      <div class="flex items-center gap-2 sm:gap-3 md:gap-4 flex-shrink-0">
        
        <!-- User Avatar -->
        <div 
          class="w-10 h-10 sm:w-11 sm:h-11 md:w-12 md:h-12 rounded-full cursor-pointer transition-transform hover:scale-110 flex items-center justify-center text-lg sm:text-xl md:text-2xl font-bold text-white"
          style="background: linear-gradient(135deg, #60a5fa 0%, #2563eb 100%);"
          title="Profile"
          aria-label="User Profile">
          👤
        </div>

        <!-- Notifications -->
        <button 
          class="transition-all p-2 sm:p-2.5 md:p-3 rounded-lg relative group"
          style="color: #4b5563;"
          onmouseover="this.style.color='#2563eb'; this.style.backgroundColor='#f0f4ff';"
          onmouseout="this.style.color='#4b5563'; this.style.backgroundColor='transparent';"
          title="Notifications"
          aria-label="Notifications">
          <span class="text-2xl sm:text-2xl md:text-3xl">🔔</span>
          <span class="absolute top-0 right-0 w-3 h-3 sm:w-4 sm:h-4 bg-red-500 rounded-full animate-pulse shadow-md"></span>
        </button>

        <!-- Settings -->
        <button 
          class="transition-all p-2 sm:p-2.5 md:p-3 rounded-lg group"
          style="color: #4b5563;"
          onmouseover="this.style.color='#2563eb'; this.style.backgroundColor='#f0f4ff';"
          onmouseout="this.style.color='#4b5563'; this.style.backgroundColor='transparent';"
          title="Settings"
          aria-label="Settings">
          <span class="text-2xl sm:text-2xl md:text-3xl">⚙️</span>
        </button>

        <!-- MOBILE FAB BUTTON - ONLY ON MOBILE (< 768px) -->
        <button 
          id="fab-questions-btn"
          class="fixed bottom-6 right-6 md:hidden w-14 h-14 rounded-full shadow-lg transition-all hover:scale-110 flex items-center justify-center text-2xl font-bold text-white"
          style="background: linear-gradient(135deg, #2563eb 0%, #1e40af 100%);"
          title="Sample Questions"
          aria-label="Sample Questions"
          onclick="toggleMobileQuestions()">
          ❓
        </button>

      </div>

    </div>
  </div>
</nav>

<!-- Horizontal Color Bar -->
<div class="w-full h-1 sm:h-2 shadow-md" style="background: linear-gradient(to right, #2563eb, #3b82f6, #1e40af);"></div>

<!-- MOBILE QUESTIONS MODAL - HIDDEN BY DEFAULT -->
<div 
  id="mobile-questions-modal"
  class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden md:hidden flex items-end"
  onclick="if(event.target === this) toggleMobileQuestions()">
  
  <!-- Modal Content - Slides up from bottom -->
  <div class="w-full bg-white rounded-t-2xl shadow-2xl max-h-[90vh] overflow-y-auto">
    
    <!-- Modal Header -->
    <div class="sticky top-0 bg-gradient-to-r from-blue-600 to-blue-700 px-4 py-4 flex items-center justify-between rounded-t-2xl">
      <h2 class="text-lg sm:text-xl font-bold text-white">Quick Questions for AI Assistant</h2>
      <button 
        class="text-white text-2xl hover:opacity-80 transition-opacity"
        onclick="toggleMobileQuestions()">
        ✕
      </button>
    </div>

    <!-- Modal Body - Questions Content -->
    <div class="p-4 sm:p-6">
      <%= render 'shared/questions_widget' %>
    </div>

  </div>

</div>

<!-- JavaScript for Mobile FAB Toggle -->
<script>
  function toggleMobileQuestions() {
    const modal = document.getElementById('mobile-questions-modal');
    const btn = document.getElementById('fab-questions-btn');
    
    if (modal.classList.contains('hidden')) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      // Prevent body scroll when modal is open
      document.body.style.overflow = 'hidden';
    } else {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      // Restore body scroll
      document.body.style.overflow = 'auto';
    }
  }
  
  // Close modal on Escape key
  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') {
      const modal = document.getElementById('mobile-questions-modal');
      if (!modal.classList.contains('hidden')) {
        toggleMobileQuestions();
      }
    }
  });
</script>

<style>
  /* Pulse animation for notification */
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.7; }
  }
  
  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  /* Logo hover effect */
  nav img {
    transition: filter 0.3s ease;
  }
  
  nav:hover img {
    filter: drop-shadow(0 8px 12px rgba(0, 0, 0, 0.15));
  }

  /* Mobile modal animation */
  @media (max-width: 767px) {
    #mobile-questions-modal.flex > div {
      animation: slideUp 0.3s ease-out;
    }

    @keyframes slideUp {
      from {
        transform: translateY(100%);
      }
      to {
        transform: translateY(0);
      }
    }
  }
</style>
